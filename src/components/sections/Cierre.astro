---
import LandingAnimation from '../LandingAnimation.astro';
import '../../styles/Cierre.css';
---

<div class="landing-cierre">
  <div id="robot4wrap" class="robot-wrapper" hidden>
    <LandingAnimation name="robot" />
  </div>
  <div class="meta-long">
    <div id="logo-container" class="logo-cont">
      <LandingAnimation name="logo" />
    </div>
  
    <div id="botonwrap" class="botones4">
      <button class="btn">Suscríbete</button>
      <button class="btn">Ingresar</button>
    </div>
  </div>

</div>
