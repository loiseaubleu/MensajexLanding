---
const { id, chat = false } = Astro.props;
---

<div id={id} class:list={["celular-nuevo", { "celular-chat": chat }]}>
  <div class="barra-superior"></div>
  <div class="pantalla">
    <slot />
  </div>
  <div class="boton-home"></div>
</div>

<style>
.celular-nuevo {
  position: relative;
  width: clamp(90px, 95vw, 190px);
  min-width: 160px;
  height: clamp(150px, 80vh, 340px); 
  background: #000;
  border-radius: clamp(5px, 2.3vw, 30px);
  padding: clamp(5px, 1.6vw, 21px);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  left: 14%;
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}

.celular-nuevo[data-awaiting-animation] {
  opacity: 0;
  transform: translateY(30px);
}

.barra-superior {
  width: 50%;
  height: 6px;
  background: #fff;
  border-radius: 9999px;
  margin-bottom: 15px;
}

.pantalla {
  background: #f0ebe5;
  flex-grow: 1;
  width: 90%;
  border-radius: 10px;
  overflow-y: auto;
  padding: clamp(0.5rem, 2vw, 1rem);
  display: flex;
  flex-direction: column;
  gap: clamp(0.5rem, 2vw, 1rem);
  position: relative;
}

.celular-chat .pantalla {
  box-sizing: border-box;
  min-height: 0;
  width: 100%;
  padding: 0.5rem;
}

.boton-home {
  width: 30px;
  height: 30px;
  background: #fff;
  border-radius: 50%;
  margin-top: 10px;
}

@media (max-width: 48rem) {
  .celular-nuevo {
    width: 28vw;
    min-width: auto;
    height: auto; 
    padding: 8px;
    border-radius: 18px;
    left: 0;
    margin: 0 auto;
  }

  .boton-home {
    width: 10px;
    height: 10px;
    margin-top: 6px;
  }

  .pantalla {
    padding: 0.5rem;
    gap: 0.5rem;
  }

  .celular-chat {
    width: min(100%, 11.875rem);
    height: clamp(16.75rem, 66vw, 18rem);
  }
}
</style>
