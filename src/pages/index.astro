---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import Inicio from '../components/sections/Inicio.astro';
import AtencionAutomatica from '../components/sections/AtencionAutomatica.astro';
import ControlTelefonico from '../components/sections/ControlTelefonico.astro';
import Cierre from '../components/sections/Cierre.astro';
---

<Layout>
  <LoadingScreen />
  <Navbar />
  <section id="mensajex" aria-label="Mensajex" data-landing-section="inicio">
    <Inicio />
  </section>
  <section aria-label="Atención automática" data-landing-section="atencion">
    <AtencionAutomatica />
  </section>
  <section aria-label="Control telefónico" data-landing-section="control">
    <ControlTelefonico />
  </section>
  <section aria-label="Suscripción e ingreso" data-landing-section="cierre">
    <Cierre />
  </section>
</Layout>

<script>
  import '../scripts/landing/start.js';
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .landing-section-entering {
      animation: landing-section-enter 0.6s ease-out;
    }

    @keyframes landing-section-enter {
      from {
        opacity: 0.55;
        transform: translateY(40px);
      }
    }
  }
</style>
